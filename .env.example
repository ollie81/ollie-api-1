# Copy to .env and fill in real values for local development.
# In production (Railway) these are set as environment variables,
# not read from this file.

# ---- Required — the app will not start without these ----
JWT_SECRET=
SUPABASE_URL=
SUPABASE_KEY=
OPENAI_API_KEY=

# ---- Phone auth (Twilio Verify) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# ---- Email auth (SendGrid) — see email_service.py for setup notes ----
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ---- Push notifications (Firebase Cloud Messaging, HTTP v1) ----
# Full contents of a Firebase service account JSON key, as one string.
FIREBASE_CREDENTIALS_JSON=

# ---- Google Play Billing purchase verification ----
# Full contents of a Play Console service-account JSON key, as one string.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Defaults already match this app's real package/product ids —
# only override if yours differ.
# ANDROID_PACKAGE_NAME=com.oliviranzi.ollie
# PLAY_MONTHLY_PRODUCT_ID=ollie_premium_monthly
# PLAY_LIFETIME_PRODUCT_ID=ollie_premium_lifetime

# ---- CORS ----
# Comma-separated allowed origins. Defaults to "*" (mobile clients
# aren't subject to CORS anyway — tighten this if a web client is added).
# ALLOWED_ORIGINS=

# ---- Error monitoring (Sentry) ----
# Optional -- empty means the SDK no-ops, nothing breaks without it.
SENTRY_DSN=

# ---- Ollie's cloned voice (ElevenLabs) ----
# Optional -- empty means /speak falls back to OpenAI's preset TTS voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
